string standalone.jobs_enqueueAdminProcessJob(Map jobInput)
{
result = Map();
result.put("error",false);
result.put("created",false);
result.put("dedup_skipped",false);
result.put("job_id","");
result.put("message","");
adminJobsModule = "Admin_Process_Jobs";
activeStatuses = Map();
activeStatuses.put("Pending",true);
activeStatuses.put("Processing",true);
activeStatuses.put("Retry",true);
activeStatuses.put("On Hold",true);
jobType = ifnull(jobInput.get("job_type"),"").toString().trim();
bookingId = ifnull(jobInput.get("booking_id"),"").toString().trim();
relatedModule = ifnull(jobInput.get("related_module"),"").toString().trim();
relatedRecordId = ifnull(jobInput.get("related_record_id"),"").toString().trim();
relatedTechnicalKey = ifnull(jobInput.get("related_technical_key"),"").toString().trim();
dedupKey = ifnull(jobInput.get("dedup_key"),"").toString().trim();
triggerReason = ifnull(jobInput.get("trigger_reason"),"").toString().trim();
sourceFunction = ifnull(jobInput.get("source_function"),"").toString().trim();
payloadJson = ifnull(jobInput.get("payload_json"),"").toString();
priority = ifnull(jobInput.get("priority"),"").toString().trim();
if(priority == "")
{
	priority = "Normal";
}
status = ifnull(jobInput.get("status"),"").toString().trim();
if(status == "")
{
	status = "Pending";
}
maxAttempts = 5;
maxAttemptsRaw = ifnull(jobInput.get("max_attempts"),"").toString().trim();
if(maxAttemptsRaw != "")
{
	try 
	{
		maxAttempts = maxAttemptsRaw.toLong();
	}
	catch (eMaxAttempts)
	{
		maxAttempts = 5;
	}
}
if(jobType == "")
{
	result.put("error",true);
	result.put("message","enqueueAdminProcessJob: job_type is required");
	return result;
}
if(dedupKey != "")
{
	try 
	{
		existingJobs = zoho.crm.searchRecords(adminJobsModule,"(Dedup_Key:equals:" + dedupKey + ")",1,200);
		if(!isnull(existingJobs) && !existingJobs.isEmpty())
		{
			for each  existingJob in existingJobs
			{
				existingStatus = ifnull(existingJob.get("Status"),"").toString().trim();
				if(!isnull(activeStatuses.get(existingStatus)))
				{
					result.put("dedup_skipped",true);
					result.put("job_id",ifnull(existingJob.get("id"),"").toString());
					result.put("message","Active job already exists for Dedup_Key");
					return result;
				}
			}
		}
	}
	catch (eExistingJobs)
	{
		result.put("error",true);
		result.put("message","enqueueAdminProcessJob: error searching existing jobs - " + eExistingJobs.toString());
		return result;
	}
}
createMap = Map();
createMap.put("Job_Type",jobType);
createMap.put("Status",status);
createMap.put("Priority",priority);
createMap.put("Attempts",0);
createMap.put("Max_Attempts",maxAttempts);
if(bookingId != "")
{
	createMap.put("Booking",bookingId);
}
if(relatedModule != "")
{
	createMap.put("Related_Module",relatedModule);
}
if(relatedRecordId != "")
{
	createMap.put("Related_Record_ID",relatedRecordId);
}
if(relatedTechnicalKey != "")
{
	createMap.put("Related_Technical_Key",relatedTechnicalKey);
}
if(dedupKey != "")
{
	createMap.put("Dedup_Key",dedupKey);
}
if(triggerReason != "")
{
	createMap.put("Trigger_Reason",triggerReason);
}
if(sourceFunction != "")
{
	createMap.put("Source_Function",sourceFunction);
}
if(payloadJson != "")
{
	createMap.put("Payload_JSON",payloadJson);
}
nextRunAt = jobInput.get("next_run_at");
nextRunAtText = "";
if(!isnull(nextRunAt) && nextRunAt != "")
{
	try 
	{
		nextRunAtText = nextRunAt.toString("yyyy-MM-dd'T'HH:mm:ssZ");
	}
	catch (eNextRunAtFormat)
	{
		nextRunAtText = nextRunAt.toString();
	}
}
else
{
	nextRunAtText = zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ssZ");
}
if(nextRunAtText != "" && nextRunAtText.length() == 24)
{
	nextRunAtText = nextRunAtText.subString(0,22) + ":" + nextRunAtText.subString(22,24);
}
if(nextRunAtText != "")
{
	createMap.put("Next_Run_At",nextRunAtText);
}
try 
{
	createRes = zoho.crm.createRecord(adminJobsModule,createMap);
	if(isnull(createRes))
	{
		result.put("error",true);
		result.put("message","enqueueAdminProcessJob: empty create response");
		return result;
	}
	createCode = ifnull(createRes.get("code"),"").toString();
	createStatus = ifnull(createRes.get("status"),"").toString();
	if(createCode.equalsIgnoreCase("error") || createStatus.equalsIgnoreCase("error") || createCode.equalsIgnoreCase("INVALID_DATA"))
	{
		result.put("error",true);
		result.put("message","enqueueAdminProcessJob: create failed - " + createRes.toString());
		return result;
	}
	createDetails = createRes.get("details");
	createdJobId = "";
	if(!isnull(createDetails))
	{
		try 
		{
			createdJobId = ifnull(createDetails.get("id"),"").toString();
		}
		catch (eCreateDetails)
		{
			createdJobId = "";
		}
	}
	result.put("created",true);
	result.put("job_id",createdJobId);
	result.put("message","Job enqueued successfully");
}
catch (eCreateJob)
{
	result.put("error",true);
	result.put("message","enqueueAdminProcessJob: error creating job - " + eCreateJob.toString());
}
return result;
}
