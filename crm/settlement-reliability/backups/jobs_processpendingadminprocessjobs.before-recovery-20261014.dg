string standalone.jobs_processPendingAdminProcessJobs()
{
result = Map();
result.put("error",false);
processedCount = 0;
jobResults = List();
errors = List();
try 
{
	nowText = standalone.jobs_formatDateTimeForCRM(zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ssXXX"));
	// Recover expired work separately so the execution quota cannot strand it.
	expired = standalone.jobs_query("select id from Admin_Process_Jobs where (Status = 'Processing' and (Lock_Expires_At <= '" + nowText + "' or Lock_Expires_At is null)) order by Modified_Time asc limit 200").get("data");
	for each  candidate in expired
	{
		try 
		{
			job = zoho.crm.getRecordById("Admin_Process_Jobs",candidate.get("id"));
			if(job.get("Status") == "Processing")
			{
				modified = job.get("Modified_Time").toString();
				// Old functions wrote wrong timezone offsets. CRM Modified_Time is trustworthy.
				expiryText = ifnull(job.get("Lock_Expires_At"),"").toString();
				oldEnough = modified.toTime("yyyy-MM-dd'T'HH:mm:ssXXX").addMinutes(30) < zoho.currenttime;
				expiredNow = expiryText == "";
				if(expiryText != "")
				{
					expiredNow = expiryText.toTime("yyyy-MM-dd'T'HH:mm:ssXXX") < zoho.currenttime;
				}
				if(oldEnough && expiredNow)
				{
					recovery = Map();
					recovery.put("Status","Retry");
					if(ifnull(job.get("Attempts"),0).toLong() >= ifnull(job.get("Max_Attempts"),5).toLong())
					{
						recovery.put("Status","Error");
					}
					recovery.put("Locked_At",null);
					recovery.put("Lock_Expires_At",null);
					recovery.put("Active_Key",null);
					recovery.put("Next_Run_At",nowText);
					recovery.put("Last_Error","Expired execution recovered; outcome was not confirmed");
					recovered = standalone.jobs_conditionalUpdate(job.get("id"),modified,recovery);
					if(recovered.get("error") == true)
					{
						errors.add("Job changed during recovery: " + job.get("id"));
					}
				}
			}
		}
		catch (recoveryError)
		{
			errors.add(recoveryError.toString());
		}
	}
	// FIFO across Pending and Retry, filtered by due date in CRM before applying the limit.
	queued = standalone.jobs_query("select id from Admin_Process_Jobs where ((Status = 'Pending' or Status = 'Retry') and (Next_Run_At <= '" + nowText + "' or Next_Run_At is null)) order by Created_Time asc, id asc limit 15").get("data");
	result.put("loaded_jobs",queued.size());
	for each  candidate in queued
	{
		try 
		{
			outcome = standalone.jobs_processAdminProcessJob(candidate);
			jobResults.add(outcome);
			if(outcome.get("skipped") != true)
			{
				processedCount = processedCount + 1;
			}
			if(outcome.get("error") == true)
			{
				errors.add("Job " + candidate.get("id") + ": " + outcome.get("message"));
			}
		}
		catch (executionError)
		{
			errors.add("Job " + candidate.get("id") + ": " + executionError);
		}
	}
}
catch (queueError)
{
	errors.add(queueError.toString());
}
result.put("error",errors.size() > 0);
result.put("errors",errors);
result.put("processed_jobs",processedCount);
result.put("job_results",jobResults);
result.put("message","Admin Process Jobs checked; see individual confirmed outcomes");
return result;
}
