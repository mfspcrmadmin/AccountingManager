string standalone.supplierInvoice_edit(String operationKey, String requestJson)
{
result = {"success":false,"retryable":false,"saved":false};
claimed = false;
invoiceId = "";
try 
{
	request = requestJson.toMap();
	invoiceId = ifnull(request.get("invoice_id"),"").toString();
	if(requestJson.length() > 16000 || !invoiceId.matches("[0-9]+") || !operationKey.matches("[a-f0-9-]{36}"))
	{
		throw "Invalid invoice edit request.";
	}
	invoice = zoho.crm.getRecordById("Supplier_Invoices",invoiceId.toLong());
	if(invoice.get("id") == null)
	{
		throw "Could not read the invoice.";
	}
	result.put("invoice_id",invoiceId);
	action = ifnull(request.get("action"),"preview");
	journal = Map();
	if(ifnull(invoice.get("Edit_Request"),"") != "")
	{
		journal = invoice.get("Edit_Request").toMap();
	}
	if(action == "preview" && invoice.get("Edit_Status") == "Pending")
	{
		result.put("can_discard",journal.get("phase") == "Prepared" && ifnull(journal.get("busy_until"),0).toLong() <= zoho.currenttime.toLong());
		result.put("pending",true);
		result.put("operation_key",journal.get("key"));
		result.put("invoice",invoice);
		result.put("success",true);
		return result.toString();
	}
	if(action != "preview" && journal.get("key") == operationKey && invoice.get("Edit_Status") == "Complete")
	{
		result.put("success",true);
		result.put("saved",true);
		return result.toString();
	}
	if(action == "discard")
	{
		if(invoice.get("Edit_Status") != "Pending" || journal.get("key") != operationKey || journal.get("phase") != "Prepared" || ifnull(journal.get("busy_until"),0).toLong() > zoho.currenttime.toLong())
		{
			throw "This correction cannot be discarded because it may have saved changes. Resume it instead.";
		}
		discarded = standalone.supplierInvoiceEdit_write("Supplier_Invoices",invoiceId,invoice.get("Modified_Time"),{"Edit_Status":"Discarded"}).toMap();
		if(discarded.get("error") == true)
		{
			throw "The correction changed while cancelling. Reload it.";
		}
		result.put("success",true);
		result.put("discarded",true);
		return result.toString();
	}
	if(invoice.get("Locked__s") == true || "Cancelled,Rejected,Reconciled".toList(",").contains(ifnull(invoice.get("Status"),"")))
	{
		throw "This invoice is locked, cancelled, rejected or reconciled and cannot be edited.";
	}
	if(invoice.get("Invoice_Type") == "Credit Note" || invoice.get("Original_Invoice") != null)
	{
		throw "Credit notes require a separate correction workflow.";
	}
	if(ifnull(invoice.get("Registration_Key"),"") != "" && invoice.get("Registration_Status") != "Complete")
	{
		throw "Finish the original registration before editing this invoice.";
	}
	if(invoice.get("Supplier") == null || invoice.get("Supplier_Settlement") == null)
	{
		throw "The invoice must have a supplier and an existing settlement.";
	}
	supplierId = invoice.get("Supplier").get("id").toString();
	primaryId = invoice.get("Supplier_Settlement").get("id").toString();
	context = Map();
	editList_moduleName = "Inv_Set_Allocations,Supplier_Pay_Allocations,Accounting_Entries,Card_Purchases,Prepayment_Invoice_Allocations".toList(",");
	for each  moduleName in editList_moduleName
	{
		relation = "Vendor_Invoice";
		if(moduleName == "Supplier_Pay_Allocations" || moduleName == "Accounting_Entries")
		{
			relation = "Supplier_Invoice";
		}
		read = standalone.supplierInvoiceEdit_read(moduleName,relation,invoiceId).toMap();
		if(read.get("success") != true)
		{
			throw read.get("message");
		}
		context.put(moduleName,read.get("records"));
	}
	entries = context.get("Accounting_Entries");
	if(entries.size() > 1)
	{
		throw "Multiple accounting entries require review before editing.";
	}
	for each  entry in entries
	{
		if(entry.get("Locked__s") == true || entry.get("Posted_At") != null || "Posted to Books,Cancelled".toList(",").contains(ifnull(entry.get("Accounting_Status"),"")) || ifnull(entry.get("Zoho_Books_Document_Id"),"") != "" || "Posted,Reconciled,Sent to Books,Exported,Cancelled".toList(",").contains(ifnull(entry.get("Books_Post_Status"),"")))
		{
			throw "Reverse the posted or exported accounting entry before editing this invoice.";
		}
	}
	paid = 0.0;
	reserved = 0.0;
	for each  allocation in context.get("Supplier_Pay_Allocations")
	{
		if("Cancelled,Void".toList(",").contains(ifnull(allocation.get("Status"),"")))
		{
			continue;
		}
		if(allocation.get("Supplier_Payment") == null)
		{
			throw "A payment allocation has no payment. Review it before editing.";
		}
		payment = zoho.crm.getRecordById("Supplier_Payments",allocation.get("Supplier_Payment").get("id").toLong());
		if(payment.get("id") == null)
		{
			throw "Could not verify an allocated payment.";
		}
		if(payment.get("Status") == "Cancelled")
		{
			continue;
		}
		amount = ifnull(allocation.get("Allocated_Amount"),0).toDecimal();
		if(amount < 0)
		{
			throw "Negative payment allocations require review.";
		}
		reserved = reserved + amount;
		if(payment.get("Status") == "Paid" || payment.get("Status") == "Reconciled")
		{
			paid = paid + amount;
		}
	}
	paid = paid.round(2);
	reserved = reserved.round(2);
	preallocated = 0.0;
	for each  link in context.get("Prepayment_Invoice_Allocations")
	{
		preallocated = preallocated + ifnull(link.get("Allocated_Amount"),0).toDecimal();
	}
	splits = List();
	settlementIds = List();
	settlements = Map();
	for each  split in context.get("Inv_Set_Allocations")
	{
		if("Void,Cancelled".toList(",").contains(ifnull(split.get("Status"),"")))
		{
			continue;
		}
		if(split.get("Vendor_Settlement") == null)
		{
			throw "An invoice allocation has no settlement.";
		}
		sid = split.get("Vendor_Settlement").get("id").toString();
		if(settlementIds.contains(sid))
		{
			throw "Duplicate settlement allocations require review.";
		}
		settlementIds.add(sid);
		splits.add(split);
	}
	if(settlementIds.isEmpty())
	{
		settlementIds.add(primaryId);
	}
	if(!settlementIds.contains(primaryId))
	{
		throw "The primary settlement is missing from the invoice allocations.";
	}
	for each  sid in settlementIds
	{
		settlement = zoho.crm.getRecordById("Supplier_Settlements",sid.toLong());
		if(settlement.get("id") == null || settlement.get("Supplier") == null || settlement.get("Supplier").get("id").toString() != supplierId || settlement.get("Admin_Status") == "Cancelled")
		{
			throw "A linked settlement is unavailable, cancelled or belongs to another supplier.";
		}
		settlements.put(sid,settlement);
	}
	if(action == "preview")
	{
		result.put("success",true);
		result.put("invoice",invoice);
		result.put("splits",splits);
		result.put("settlements",settlements);
		result.put("paid",paid);
		result.put("reserved",reserved);
		result.put("has_accounting",!entries.isEmpty());
		return result.toString();
	}
	if(action != "save" && action != "resume")
	{
		throw "Invalid invoice edit action.";
	}
	if(invoice.get("Edit_Status") == "Pending")
	{
		if(journal.get("key") != operationKey)
		{
			throw "Another edit is pending. Resume it before starting a new correction.";
		}
		if(ifnull(journal.get("busy_until"),0).toLong() > zoho.currenttime.toLong())
		{
			throw "The previous save is still running. Please wait before retrying.";
		}
		if(action == "save" && journal.get("input") != requestJson)
		{
			throw "The pending operation contains different changes. Resume the saved correction.";
		}
	}
	else
	{
		if(action != "save" || invoice.get("Modified_Time") != request.get("modified_time"))
		{
			throw "The invoice changed since it was opened. Reload it before saving.";
		}
		if(ifnull(request.get("reason"),"").toString().trim() == "")
		{
			throw "Enter the reason for this correction.";
		}
		fields = request.get("fields");
		if(fields == null)
		{
			throw "Missing invoice values.";
		}
		header = Map();
		name = ifnull(fields.get("Name"),"").toString().trim();
		date = ifnull(fields.get("Invoice_Date"),"").toString();
		type = ifnull(fields.get("Invoice_Type"),"").toString();
		if(name == "" || name.length() > 120 || !date.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}") || date.toDate("yyyy-MM-dd").toString("yyyy-MM-dd") != date || !"Proforma,Final Invoice,Tickets,Commission".toList(",").contains(type))
		{
			throw "Enter a valid invoice number, date and type.";
		}
		header.put("Name",name);
		header.put("Invoice_Date",date);
		header.put("Invoice_Type",type);
		editList_field = "Invoice_Amount_Excl_VAT,VAT_percentage,IRPF_percentage,Additional_Amount_Excl_VAT,Additional_VAT_percentage,Additional_IRPF_percentage,Reimbursable_Expense".toList(",");
		for each  field in editList_field
		{
			value = ifnull(fields.get(field),0).toDecimal();
			if(value < 0 || value.round(2) != value || field.contains("percentage") && value > 100)
			{
				throw "Invalid value for " + field + ".";
			}
			header.put(field,value);
		}
		if(request.get("vat_reviewed") != true || request.get("irpf_reviewed") != true || header.get("Additional_Amount_Excl_VAT") > 0 && (request.get("additional_vat_reviewed") != true || request.get("additional_irpf_reviewed") != true))
		{
			throw "Confirm the Reviewed checkboxes before saving.";
		}
		net = header.get("Invoice_Amount_Excl_VAT");
		extra = header.get("Additional_Amount_Excl_VAT");
		gross = (net * (1 + header.get("VAT_percentage") / 100)).round(2);
		extraGross = (extra * (1 + header.get("Additional_VAT_percentage") / 100)).round(2);
		tax = (net * header.get("IRPF_percentage") / 100).round(2);
		extraTax = (extra * header.get("Additional_IRPF_percentage") / 100).round(2);
		total = (gross + extraGross - tax - extraTax).round(2);
		payable = (total + header.get("Reimbursable_Expense")).round(2);
		if(total <= 0 || payable < reserved || payable < preallocated || paid != ifnull(invoice.get("Amount_Paid"),0).toDecimal().round(2))
		{
			throw "The new total is invalid, below existing allocations, or the stored paid amount needs reconciliation.";
		}
		supplier = zoho.crm.getRecordById("Vendors",supplierId.toLong());
		if(supplier.get("id") == null || (tax > 0 || extraTax > 0) && supplier.get("Is_Self_Employed") != true)
		{
			throw "Verify the supplier and self-employment setting before applying withholding.";
		}
		header.put("Invoice_Amount_Incl_VAT",gross);
		header.put("VAT_Amount",(gross - net).round(2));
		header.put("IRPF_Amount",tax);
		header.put("Additional_Amount_Incl_VAT",extraGross);
		header.put("Additional_VAT_Amount",(extraGross - extra).round(2));
		header.put("Additional_IRPF_Amount",extraTax);
		header.put("Invoice_Total",total);
		header.put("Total_Payable_Amount",payable);
		fileId = ifnull(request.get("file_id"),"").toString();
		if(fileId != "" && !fileId.matches("[A-Za-z0-9_-]+"))
		{
			throw "Invalid invoice file.";
		}
		if(fileId == "" && (invoice.get("Invoice_File") == null || invoice.get("Invoice_File").isEmpty()))
		{
			throw "Attach the invoice document before saving.";
		}
		allocated = 0.0;
		splitPlan = List();
		requestedSplits = request.get("allocations");
		if(requestedSplits == null || requestedSplits.keys().size() != settlementIds.size())
		{
			throw "Allocate the new payable amount across the existing settlements.";
		}
		for each  sid in settlementIds
		{
			amount = ifnull(requestedSplits.get(sid),0).toDecimal();
			if(amount <= 0 || amount != amount.round(2))
			{
				throw "Enter a positive allocation with at most two decimals for every settlement.";
			}
			allocated = allocated + amount;
			oldAmount = ifnull(invoice.get("Total_Payable_Amount"),0).toDecimal();
			for each  split in splits
			{
				if(split.get("Vendor_Settlement").get("id").toString() == sid)
				{
					oldAmount = ifnull(split.get("Allocated_Amount"),0).toDecimal();
					splitPlan.add({"id":split.get("id"),"settlement_id":sid,"before":oldAmount,"after":amount});
				}
			}
			settlement = settlements.get(sid);
			if(ifnull(settlement.get("Total_Invoice"),0).toDecimal() - oldAmount + amount > ifnull(settlement.get("Total_Service_Cost"),0).toDecimal() && request.get("confirm_excess") != true)
			{
				throw "The corrected invoice exceeds a settlement service cost. Review and confirm the excess.";
			}
		}
		if(allocated.round(2) != payable)
		{
			throw "Settlement allocations must equal the new total payable amount.";
		}
		status = ifnull(invoice.get("Status"),"Received");
		if(paid > 0)
		{
			status = if(paid >= payable,"Paid","Partially Paid");
		}
		else if(status == "Paid" || status == "Partially Paid")
		{
			status = "Received";
		}
		header.put("Status",status);
		accounting = Map();
		if(!entries.isEmpty())
		{
			accounting = standalone.supplierInvoiceEdit_accountingPlan(invoiceId,header.toString()).toMap();
			if(accounting.get("error") == true || accounting.get("entry") == null)
			{
				throw "Accounting validation: " + ifnull(accounting.get("message"),"Could not build an accounting plan.");
			}
		}
		if(!entries.isEmpty())
		{
			accounting.put("entry_id",entries.get(0).get("id").toString());
			oldEntry = Map();
			accountingHeader = accounting.get("entry");
			for each  field in accountingHeader.keys()
			{
				oldEntry.put(field,entries.get(0).get(field));
			}
			accounting.put("before_entry",oldEntry);
			originalLines = standalone.supplierInvoiceEdit_read("Accounting_Entry_Lines","Accounting_Entry",entries.get(0).get("id").toString()).toMap();
			if(originalLines.get("success") != true)
			{
				throw originalLines.get("message");
			}
			lineSnapshot = Map();
			for each  line in originalLines.get("records")
			{
				if(line.get("Locked__s") == true)
				{
					throw "An accounting line is locked.";
				}
				lineSnapshot.put(line.get("id").toString(),{"Debit":line.get("Debit"),"Credit":line.get("Credit"),"Account":line.get("Account"),"Modified_Time":line.get("Modified_Time")});
			}
			accounting.put("before_lines",lineSnapshot);
		}
		before = Map();
		for each  field in header.keys()
		{
			before.put(field,invoice.get(field));
		}
		journal = {"phase":"Prepared","key":operationKey,"input":requestJson,"before":before,"header":header,"file_id":fileId,"splits":splitPlan,"settlement_ids":settlementIds,"accounting":accounting,"paid":paid,"supplier_id":supplierId,"primary_id":primaryId,"cards":context.get("Card_Purchases"),"reason":request.get("reason")};
		if(journal.toString().length() > 30000)
		{
			throw "This correction has too many related records. No changes were made.";
		}
	}
	header = journal.get("header");
	if(splits.size() != journal.get("splits").size())
	{
		throw "The settlement allocations changed outside this correction.";
	}
	for each  split in splits
	{
		known = false;
		for each  target in journal.get("splits")
		{
			if(target.get("id") == split.get("id") && target.get("settlement_id") == split.get("Vendor_Settlement").get("id").toString())
			{
				known = true;
			}
		}
		if(!known)
		{
			throw "The settlement allocation relationships changed outside this correction.";
		}
	}
	if(paid != journal.get("paid") || reserved > header.get("Total_Payable_Amount") || preallocated > header.get("Total_Payable_Amount") || supplierId != journal.get("supplier_id") || primaryId != journal.get("primary_id"))
	{
		throw "Payments or invoice relationships changed. Review the pending edit before continuing.";
	}
	for each  field in header.keys()
	{
		current = invoice.get(field);
		if(current != journal.get("before").get(field) && current != header.get(field))
		{
			throw "The invoice was modified outside this correction: " + field;
		}
	}
	journal.put("busy_until",zoho.currenttime.toLong() + 300000);
	claim = standalone.supplierInvoiceEdit_write("Supplier_Invoices",invoiceId,invoice.get("Modified_Time"),{"Edit_Status":"Pending","Edit_Request":journal.toString()}).toMap();
	if(claim.get("error") == true)
	{
		throw "Another update was detected. Reload the invoice.";
	}
	claimed = true;
	result.put("retryable",true);
	invoice = zoho.crm.getRecordById("Supplier_Invoices",invoiceId.toLong());
	if(invoice.get("Edit_Request").toMap().get("key") != operationKey)
	{
		throw "Another correction owns this invoice. Reload it.";
	}
	fileId = journal.get("file_id");
	headerWrite = Map();
	for each  field in header.keys()
	{
		headerWrite.put(field,header.get(field));
	}
	if(fileId != "")
	{
		files = List();
		found = false;
		if(invoice.get("Invoice_File") != null)
		{
			for each  file in invoice.get("Invoice_File")
			{
				files.add({"id":file.get("id")});
				if(file.get("File_Id__s") == fileId)
				{
					found = true;
				}
			}
		}
		if(!found)
		{
			files.add({"File_Id__s":fileId});
			headerWrite.put("Invoice_File",files);
		}
	}
	journal.put("phase","Applied");
	headerWrite.put("Edit_Request",journal.toString());
	saved = standalone.supplierInvoiceEdit_write("Supplier_Invoices",invoiceId,invoice.get("Modified_Time"),headerWrite).toMap();
	if(saved.get("error") == true)
	{
		throw "The invoice changed while saving. Resume after reviewing the latest values.";
	}
	result.put("saved",true);
	for each  target in journal.get("splits")
	{
		split = zoho.crm.getRecordById("Inv_Set_Allocations",target.get("id").toLong());
		if("Void,Cancelled".toList(",").contains(ifnull(split.get("Status"),"")) || split.get("Vendor_Settlement") == null || split.get("Vendor_Settlement").get("id").toString() != target.get("settlement_id") || split.get("Vendor_Invoice") == null || split.get("Vendor_Invoice").get("id").toString() != invoiceId || split.get("Allocated_Amount") != target.get("before") && split.get("Allocated_Amount") != target.get("after"))
		{
			throw "A settlement allocation changed outside this correction.";
		}
		saved = standalone.supplierInvoiceEdit_write("Inv_Set_Allocations",target.get("id").toString(),split.get("Modified_Time"),{"Allocated_Amount":target.get("after")}).toMap();
		if(saved.get("error") == true)
		{
			throw "A settlement allocation changed while saving.";
		}
	}
	accounting = journal.get("accounting");
	if(accounting.get("entry") != null)
	{
		if(entries.size() != 1 || entries.get(0).get("id").toString() != accounting.get("entry_id"))
		{
			throw "The accounting entry changed. Review it before resuming.";
		}
		accountingResult = standalone.supplierInvoiceEdit_applyAccounting(entries.get(0).get("id").toString(),invoiceId,operationKey,accounting.toString()).toMap();
		if(accountingResult.get("success") != true)
		{
			throw accountingResult.get("message");
		}
	}
	for each  card in journal.get("cards")
	{
		liveCard = zoho.crm.getRecordById("Card_Purchases",card.get("id").toLong());
		if(liveCard.get("Vendor_Invoice") == null || liveCard.get("Vendor_Invoice").get("id").toString() != invoiceId)
		{
			throw "A linked card purchase changed.";
		}
		if(liveCard.get("Invoice_Number") != card.get("Invoice_Number") && liveCard.get("Invoice_Number") != header.get("Name"))
		{
			throw "The linked card invoice number changed outside this correction.";
		}
		saved = standalone.supplierInvoiceEdit_write("Card_Purchases",card.get("id").toString(),liveCard.get("Modified_Time"),{"Invoice_Number":header.get("Name")}).toMap();
		if(saved.get("error") == true)
		{
			throw "The linked card purchase changed while saving.";
		}
	}
	ids = "";
	for each  sid in journal.get("settlement_ids")
	{
		ids = if(ids == "",sid,ids + "|||" + sid);
	}
	rebuilt = standalone.rebuildSupplierSettlementTotals(ids).toMap();
	if(rebuilt.get("error") == true || ifnull(rebuilt.get("warning_count"),0) > 0)
	{
		throw "Invoice saved; settlement recalculation is incomplete. Resume this correction. " + ifnull(rebuilt.get("message"),"");
	}
	invoice = zoho.crm.getRecordById("Supplier_Invoices",invoiceId.toLong());
	for each  field in header.keys()
	{
		if(invoice.get(field) != header.get(field))
		{
			throw "The saved invoice did not retain " + field + ".";
		}
	}
	if(invoice.get("Invoice_File") == null || invoice.get("Invoice_File").isEmpty())
	{
		throw "The saved invoice document is missing.";
	}
	if(ifnull(invoice.get("Amount_Paid"),0).toDecimal().round(2) != journal.get("paid"))
	{
		throw "A payment changed while saving. Review the invoice balance before completing this correction.";
	}
	if(fileId != "")
	{
		found = false;
		for each  file in invoice.get("Invoice_File")
		{
			if(file.get("File_Id__s") == fileId)
			{
				found = true;
			}
		}
		if(!found)
		{
			throw "The corrected invoice file was not saved. Resume the correction.";
		}
	}
	journal.put("busy_until",0);
	saved = standalone.supplierInvoiceEdit_write("Supplier_Invoices",invoiceId,invoice.get("Modified_Time"),{"Edit_Status":"Complete","Edit_Request":journal.toString()}).toMap();
	if(saved.get("error") == true)
	{
		throw "Could not confirm completion. Resume the correction.";
	}
	result.put("success",true);
	result.put("retryable",false);
	result.put("message","Invoice and related totals updated. Existing payments were preserved.");
}
catch (e)
{
	result.put("message",e.toString());
	if(claimed)
	{
		try 
		{
			live = zoho.crm.getRecordById("Supplier_Invoices",invoiceId.toLong());
			pending = live.get("Edit_Request").toMap();
			if(pending.get("key") == operationKey)
			{
				if(pending.get("phase") == "Applied")
				{
					result.put("saved",true);
				}
				pending.put("busy_until",0);
				standalone.supplierInvoiceEdit_write("Supplier_Invoices",invoiceId,live.get("Modified_Time"),{"Edit_Request":pending.toString()});
			}
		}
		catch (cleanupError)
		{
			result.put("recovery_message","The save may still be active. Wait five minutes before resuming.");
		}
	}
}
return result.toString();
}
