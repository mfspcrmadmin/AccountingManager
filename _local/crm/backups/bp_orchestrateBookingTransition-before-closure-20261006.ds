string standalone.bp_orchestrateBookingTransition(String bookingReference, String referenceType, String transitionCode)
{
res = Map();
res.put("error",false);
res.put("transition",transitionCode);
booking = Map();
ezusProjectRef = "";
if(referenceType.equals("booking_id"))
{
	booking = zoho.crm.getRecordById("Deals",bookingReference.toLong());
	if(isnull(booking) || booking.isEmpty())
	{
		res.put("error",true);
		res.put("message","Booking not found: " + bookingReference);
		return res;
	}
	ezusProjectRef = ifnull(booking.get("Ezus_Project_ID"),"");
}
else if(referenceType.equals("ezus_project_ref"))
{
	ezusProjectRef = ifnull(bookingReference,"");
}
else
{
	res.put("error",true);
	res.put("message","Unsupported booking reference type: " + referenceType);
	return res;
}
// The Blueprint only supplies the transition. All side effects are centralized here.
if(transitionCode.equals("create_project"))
{
	if(!referenceType.equals("booking_id"))
	{
		res.put("error",true);
		res.put("message","create_project requires a booking id.");
		return res;
	}
	creationResult = standalone.createProjectInEzus(bookingReference.toLong());
	res.put("create_project",creationResult);
	if(isnull(creationResult) || ifnull(creationResult.get("error"),true).toString() != "false")
	{
		res.put("error",true);
		res.put("message",ifnull(ifnull(creationResult,Map()).get("message"),"Ezus project creation was not confirmed."));
	}
	return res;
}
if(transitionCode.equals("booking_won"))
{
	if(!referenceType.equals("booking_id"))
	{
		res.put("error",true);
		res.put("message","booking_won requires a booking id.");
		return res;
	}
	arrivalDate = ifnull(booking.get("Arrival_Date"),"");
	if(arrivalDate != "")
	{
		isHighPriority = false;
		daysUntilArrival = zoho.currentdate.daysBetween(arrivalDate.toDate());
		if(daysUntilArrival >= 0 && daysUntilArrival <= 15)
		{
			isHighPriority = true;
		}
		highPriorityUpdate = Map();
		highPriorityUpdate.put("High_Priority_Booking",isHighPriority);
		res.put("high_priority",zoho.crm.updateRecord("Deals",bookingReference.toLong(),highPriorityUpdate));
	}
	if(ezusProjectRef != "")
	{
		res.put("ezus_stage",standalone.changeEzusProjectStage(ezusProjectRef,"pending-res-assignment"));
		options = Map();
		options.put("syncProject",true);
		options.put("syncTravellers",true);
		options.put("syncServices",true);
		options.put("dryRun",false);
		options.put("skipDeletes",false);
		syncArgs = Map();
		syncArgs.put("options",options);
		res.put("sync",standalone.sync_syncFullProjectFromEzus(bookingReference,syncArgs.toString()));
	}
	else
	{
		res.put("message","Booking has no Ezus project reference. Ezus sync skipped.");
	}
	res.put("notification",standalone.notif_sendEmailViaTemplate("Deals",bookingReference.toLong(),"616617000135016204",standalone.email_getTeamEmails(),"",""));
	return res;
}
if(transitionCode.equals("auto_assign_booking_won"))
{
	if(!referenceType.equals("booking_id"))
	{
		res.put("error",true);
		res.put("message","auto_assign_booking_won requires a booking id.");
		return res;
	}
	// Auto Assign uses the booking's Sales Rep, including native CRM transitions.
	salesRepId = ifnull(ifnull(booking.get("Sales_Rep"),Map()).get("id"),"").toString().trim();
	if(salesRepId == "")
	{
		res.put("error",true);
		res.put("message","Auto Assign requires a Sales Rep on the booking.");
		return res;
	}
	reservationRep = Map();
	reservationRep.put("id",salesRepId);
	assignment = Map();
	assignment.put("Reservation_Rep",reservationRep);
	assignmentResult = zoho.crm.updateRecord("Deals",bookingReference.toLong(),assignment);
	res.put("reservation_assignment",assignmentResult);
	if(isnull(assignmentResult) || isnull(assignmentResult.get("id")))
	{
		res.put("error",true);
		res.put("message","Could not assign Sales Rep to Reservation Rep. Details: " + assignmentResult);
		return res;
	}
	if(ezusProjectRef.trim() == "")
	{
		res.put("message","Booking has no Ezus project reference. Operation aborted.");
		return res;
	}
	arrivalDate = ifnull(booking.get("Arrival_Date"),"");
	if(arrivalDate != "")
	{
		isHighPriority = false;
		daysUntilArrival = zoho.currentdate.daysBetween(arrivalDate.toDate());
		if(daysUntilArrival >= 0 && daysUntilArrival <= 15)
		{
			isHighPriority = true;
		}
		highPriorityUpdate = Map();
		highPriorityUpdate.put("High_Priority_Booking",isHighPriority);
		res.put("high_priority",zoho.crm.updateRecord("Deals",bookingReference.toLong(),highPriorityUpdate));
	}
	else
	{
		res.put("high_priority_message","Booking has no arrival date. High Priority Booking flag was not updated.");
	}
	deskTicketId = ifnull(booking.get("Desk_Ticket_ID"),"");
	if(deskTicketId != "" && deskTicketId != "-")
	{
		deskOrgId = 20093303993;
		ticketUpdateMap = Map();
		ticketUpdateMap.put("teamId",152133000000252571);
		res.put("desk_team",zoho.desk.update(deskOrgId,"tickets",deskTicketId,ticketUpdateMap));
	}
	else
	{
		res.put("desk_team_message","Booking has no Desk ticket id. Desk team update skipped.");
	}
	res.put("ezus_stage",standalone.changeEzusProjectStage(ezusProjectRef,"reservation-in-progress_1"));
	options = Map();
	options.put("syncProject",true);
	options.put("syncTravellers",true);
	options.put("syncServices",true);
	options.put("dryRun",false);
	options.put("skipDeletes",false);
	syncArgs = Map();
	syncArgs.put("options",options);
	res.put("sync",standalone.sync_syncFullProjectFromEzus(bookingReference,syncArgs.toString()));
	res.put("notification",standalone.notif_sendEmailViaTemplate("Deals",bookingReference.toLong(),"616617000135016204",standalone.email_getTeamEmails(),"",""));
	return res;
}
if(transitionCode.equals("cancelled") || transitionCode.equals("cancelled_with_charges") || transitionCode.equals("have_departed") || transitionCode.equals("marked_dead"))
{
	if(referenceType.equals("booking_id"))
	{
		if(transitionCode.equals("cancelled") || transitionCode.equals("cancelled_with_charges") || transitionCode.equals("have_departed"))
		{
			res.put("owner_assignment",standalone.bp_assignBookingAndDeskToAccountingRep(bookingReference));
		}
		else if(transitionCode.equals("marked_dead"))
		{
			ownerUpdate = Map();
			ownerUpdate.put("Owner","616617000000365001");
			res.put("owner_assignment",zoho.crm.updateRecord("Deals",bookingReference.toLong(),ownerUpdate));
		}
		deskTicketId = ifnull(booking.get("Desk_Ticket_ID"),"");
		if((transitionCode.equals("cancelled") || transitionCode.equals("cancelled_with_charges") || transitionCode.equals("marked_dead")) && deskTicketId != "" && deskTicketId != "-")
		{
			res.put("desk",standalone.updateDeskTicketStatusByTransition(deskTicketId,"dead"));
		}
	}
}
ezusStageByTransition = Map();
ezusStageByTransition.put("proposal_changes_requested","quotation");
ezusStageByTransition.put("proposal_sent","proposal_sent");
ezusStageByTransition.put("fid_review_requested","pending-review");
ezusStageByTransition.put("fid_review_started","fid-in-review");
ezusStageByTransition.put("fid_sent","fid-sent");
ezusStageByTransition.put("fid_review_completed","review-done");
ezusStageByTransition.put("changes_completed","reservation-in-progress_1");
ezusStageByTransition.put("trip_changes_requested","changes-requested");
ezusStageByTransition.put("guests_arrived","on-tour");
ezusStageByTransition.put("have_departed","trip-accounting-closure");
ezusStageByTransition.put("trip_accounting_closure","trip-accounting-closure");
ezusStageByTransition.put("all_services_booked","all-services-confirmed");
ezusStageByTransition.put("accounting_completed","booking-completed");
ezusStageByTransition.put("cancelled","cancelled");
ezusStageByTransition.put("cancelled_with_charges","cancelled-with-charges_1");
ezusStageByTransition.put("marked_dead","dead");
newStage = ifnull(ezusStageByTransition.get(transitionCode),"");
if(newStage == "")
{
	res.put("error",true);
	res.put("message","Unsupported booking transition: " + transitionCode);
	return res;
}
if(ezusProjectRef == "")
{
	res.put("message","Booking has no Ezus project reference. Ezus stage update skipped.");
}
else
{
	res.put("ezus_stage",standalone.changeEzusProjectStage(ezusProjectRef,newStage));
	if(transitionCode.equals("fid_sent") || transitionCode.equals("changes_completed"))
	{
		syncBookingId = bookingReference;
		if(referenceType.equals("ezus_project_ref"))
		{
			bookingMatches = zoho.crm.searchRecords("Deals","(Ezus_Project_ID:equals:" + ezusProjectRef + ")",1,2);
			if(isnull(bookingMatches) || bookingMatches.size() != 1)
			{
				res.put("error",true);
				res.put("message","Full sync requires exactly one CRM booking for Ezus project: " + ezusProjectRef);
				return res;
			}
			syncBookingId = ifnull(bookingMatches.get(0).get("id"),"").toString();
			if(syncBookingId == "")
			{
				res.put("error",true);
				res.put("message","Could not resolve CRM booking id for Ezus project: " + ezusProjectRef);
				return res;
			}
		}
		options = Map();
		options.put("syncProject",true);
		options.put("syncTravelers",true);
		options.put("syncServices",true);
		options.put("dryRun",false);
		options.put("skipDeletes",false);
		syncArgs = Map();
		syncArgs.put("options",options);
		res.put("sync",standalone.sync_syncFullProjectFromEzus(syncBookingId,syncArgs.toString()));
	}
}
if(transitionCode.equals("marked_dead") && referenceType.equals("booking_id"))
{
	res.put("notification",standalone.notif_sendManagerDeadBooking(bookingReference.toLong()));
}
return res;
}
