debugInfo.put("group_summaries",debugGroupSummaries);
debugInfo.put("existing_settlement_summaries",debugExistingSettlementSummaries);
debugInfo.put("service_relink_actions",debugServiceRelinkActions);
debugInfo.put("marked_no_services",debugMarkedNoServices);
debugInfo.put("mark_no_services_payloads",debugMarkNoServicesPayloads);
debugInfo.put("mark_no_services_responses",debugMarkNoServicesResponses);
result.put("debug",debugInfo);
info "recalculateSupplierSettlementsForBooking debug: " + debugInfo.toString();
return result;
}
