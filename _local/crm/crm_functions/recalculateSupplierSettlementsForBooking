debugInfo.put("to_create_count",toCreateSettlements.size());
debugInfo.put("to_update_count",toUpdateSettlements.size());
debugInfo.put("create_payload_samples",debugCreatePayloadSamples);
debugInfo.put("create_response_samples",debugCreateResponseSamples);
debugInfo.put("reloaded_settlement_ids",debugReloadedSettlementIds);
debugInfo.put("technical_key_fallback_hits",debugTechnicalKeyFallbackHits);
debugInfo.put("resolved_settlement_id_count",settlementIdByTechnicalKey.size());
