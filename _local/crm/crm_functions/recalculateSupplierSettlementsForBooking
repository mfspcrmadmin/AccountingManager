result.put("message","Supplier Settlements recalculated successfully.");
result.put("services_count",allServices.size());
result.put("services_skipped_cancelled",cancelledServicesSkippedCount);
result.put("settlements_created",createCount);
result.put("settlements_updated",updateCount);
result.put("services_linked_or_relinked",serviceUpdateCount);
result.put("settlements_marked_no_services",inactiveCount);
result.put("duplicate_technical_keys_detected",duplicateSettlementKeys.size());
result.put("settlement_create_errors",createErrorCount);
result.put("settlement_update_errors",updateErrorCount);
result.put("service_link_errors",serviceUpdateErrorCount);
result.put("settlements_mark_no_services_errors",inactiveErrorCount);
result.put("created_settlement_ids_captured",createdSettlementIdByTechnicalKey.size());
result.put("agent_commission",agentCommissionResult);
result.put("supplier_services_type_backfilled",supplierServicesTypeBackfilledCount);
result.put("supplier_services_type_backfill_errors",supplierServicesTypeBackfillErrorCount);
debugInfo.put("existing_settlement_count_loaded",existingSettlementByTechnicalKey.size());
