form RENFE_Payments_Form
{
	displayname = "RENFE Payments Form"
	success message = "Renfe Payment Added Successfully"
	Section
	(
		type = section
	 	row = 1
	 	column = 0   
		width = medium
	)
	Service_ID
	(
    	type = text
		displayname = "Service ID"
		private = true
	 	row = 1
	 	column = 1   
		width = medium
	)
	Requested_Date
	(
    	type = date
		displayname = "Requested Date"
		initial value = "${zoho.currentdate}"
		alloweddays = 0,1,2,3,4,5,6
	 	row = 1
	 	column = 1   
		width = medium
	)
	Requested_By
	(
    	type = email
		displayname = "Requested By"
		initial value = "${zoho.loginuserid}"
		maxchar = 80
	 	row = 1
	 	column = 1   
		width = medium
		personal data = true
	)
	must have MFSP_Reference
	(
    	type = text
		displayname = "MFSP Reference"
	 	row = 1
	 	column = 1   
		width = medium
	)
	must have Booking_Name
	(
    	type = text
		displayname = "Booking Name"
	 	row = 1
	 	column = 1   
		width = medium
	)
	must have Localizador_Ticket_RENFE
	(
    	type = text
		displayname = "Localizador Ticket RENFE"
	 	row = 1
	 	column = 1   
		width = medium
	)
	must have Total_Tickets_Amount
	(
		displayname = "Total Tickets Amount"
		type = EUR
		format = dotcomma
	 	row = 1
	 	column = 1   
		width = medium
	)
	Observations
	(
    	type = textarea
		height = 100px
	 	row = 1
	 	column = 1   
		width = medium
	)
	
	actions
	{
		on add
		{
			submit
			(
   				type = submit
   				displayname = "Submit"
			)
		}
		on edit
		{
			update
			(
   				type = submit
   				displayname = "Update"
			)
			cancel
			(
   				type = cancel
   				displayname = "Cancel"
			)
		}
	}
}
